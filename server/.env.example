# Local accounts. In hosting, configure these as secret environment variables.
USER_1=F
PASSWORD_1=replace-with-a-strong-password
USER_2=N
PASSWORD_2=replace-with-another-strong-password
PORT=3000
# Production requires PostgreSQL (e.g. Neon Free). Use its TLS connection string.
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Cloudflare Realtime TURN key: kept ONLY on the server.
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Optional self-hosted coturn instead of Cloudflare:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=
